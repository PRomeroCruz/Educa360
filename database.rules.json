{
  "rules": {
    
    "usuarios": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.rol === 'admin' || auth.token.rol === 'profesional')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.rol === 'admin')"
      }
    },

    "pacientes": {
      "$pacienteId": {
        ".read": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || (auth.token.rol === 'paciente' && auth.uid === $pacienteId))",
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')"
      }
    },

    "profesionales": {
      "$profesionalId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.rol === 'admin'"
      }
    },

    "citas": {
      "$citaId": {
        ".read": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')",
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')"
      }
    },

    "actos_clinicos": {
      "$actoId": {
        ".read": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante')",
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')"
      }
    },

    "solicitudes_prueba": {
      "$solicitudId": {
        ".read": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')",
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')"
      }
    },

    "resultados": {
      "$resultadoId": {
        ".read": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')",
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')"
      }
    },

    "asignaciones_docentes": {
      "$asignacionId": {
        ".read": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || auth.token.rol === 'profesional')",
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente')"
      }
    },

    "contenido_portal": {
      ".read": true,
      "$contenidoId": {
        ".write": "auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')"
      }
    }

  }
}