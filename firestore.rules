rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. GESTIÓN DE USUARIOS Y ACCESOS
    match /usuarios/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || 
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional'
      );
      allow write: if request.auth != null && (
        request.auth.uid == uid || 
        request.auth.get('token', {}).get('rol', '') == 'admin'
      );
    }

    // 2. PACIENTES
    match /pacientes/{pacienteId} {
      allow read: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional' || 
        request.auth.get('token', {}).get('rol', '') == 'docente' || 
        request.auth.get('token', {}).get('rol', '') == 'estudiante' || 
        (request.auth.get('token', {}).get('rol', '') == 'paciente' && request.auth.uid == pacienteId)
      );
      allow write: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional'
      );
    }

    // 3. PROFESIONALES
    match /profesionales/{profesionalId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.get('token', {}).get('rol', '') == 'admin';
    }

    // 4. CITAS
    match /citas/{citaId} {
      allow read, write: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional' || 
        request.auth.get('token', {}).get('rol', '') == 'paciente'
      );
    }

    // 5. ACTOS CLÍNICOS
    match /actos_clinicos/{actoId} {
      allow read: if request.auth != null && (
        resource == null || 
        resource.data.professional_id == request.auth.uid ||
        resource.data.paciente_id == request.auth.uid ||
        request.auth.get('token', {}).get('rol', '') in ['admin', 'profesional', 'docente', 'estudiante']
      );
      
      allow create: if request.auth != null && request.auth.get('token', {}).get('rol', '') == 'profesional';
      
      allow update: if request.auth != null 
        && resource != null 
        && resource.data.estado == 'Borrador' 
        && request.resource.data.estado in ['Borrador', 'Firmado']
        && (request.auth.get('token', {}).get('rol', '') == 'admin' || request.auth.get('token', {}).get('rol', '') == 'profesional');
        
      allow delete: if false;
    }

    // 6. SOLICITUDES DE PRUEBA
    match /solicitudes_prueba/{solicitudId} {
      allow read: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional' || 
        request.auth.get('token', {}).get('rol', '') == 'paciente'
      );
      allow write: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional'
      );
    }

    // 7. RESULTADOS
    match /resultados/{resultadoId} {
      allow read: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional' || 
        request.auth.get('token', {}).get('rol', '') == 'paciente'
      );
      allow write: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional'
      );
    }

    // 8. ASIGNACIONES DOCENTES
    match /asignaciones_docentes/{asignacionId} {
      allow read: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'docente' || 
        request.auth.get('token', {}).get('rol', '') == 'estudiante' || 
        request.auth.get('token', {}).get('rol', '') == 'profesional'
      );
      allow write: if request.auth != null && (
        request.auth.get('token', {}).get('rol', '') == 'admin' || 
        request.auth.get('token', {}).get('rol', '') == 'docente'
      );
    }

    // 9. CONTENIDO DEL PORTAL
    match /contenido_portal/{contenidoId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.get('token', {}).get('rol', '') == 'admin';
    }

    // 10. AUDITORÍA
    match /auditoria/{logId} {
      allow read: if request.auth != null && (
        resource.data.paciente_id == request.auth.uid ||
        request.auth.get('token', {}).get('rol', '') == 'admin' ||
        request.auth.get('token', {}).get('rol', '') == 'profesional'
      );
      
      allow create: if request.auth != null && request.resource.data.usuario_id == request.auth.uid;
      
      allow update, delete: if false;
    }

  }
}