[debug] [2026-11-09T10:22:34.410Z] >>> [apiv2][body] PUT http://127.0.0.1:9000/.settings/rules.json "{\n  \"rules\": {\n    \n    // 1. GESTIÓN DE USUARIOS Y ACCESOS\n    \"usuarios\": {\n      \"$uid\": {\n        // Cada usuario lee su perfil; admin y profesional pueden listar/ver accesos\n        \".read\": \"auth != null && (auth.uid === $uid || auth.token.rol === 'admin' || auth.token.rol === 'profesional')\",\n        // Solo el propio usuario (ciertos datos) o el administrador pueden editar\n        \".write\": \"auth != null && (auth.uid === $uid || auth.token.rol === 'admin')\"\n      }\n    },\n\n    // 2. PACIENTES\n    \"pacientes\": {\n      \"$pacienteId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || (auth.token.rol === 'paciente' && auth.uid === $pacienteId))\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    // 3. PROFESIONALES\n    \"profesionales\": {\n      \"$profesionalId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null && auth.token.rol === 'admin'\"\n      }\n    },\n\n    // 4. CITAS\n    \"citas\": {\n      \"$citaId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\"\n      }\n    },\n\n    // 5. ACTOS CLÍNICOS\n    \"actos_clinicos\": {\n      \"$actoId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    // 6. SOLICITUDES DE PRUEBA\n    \"solicitudes_prueba\": {\n      \"$solicitudId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    // 7. RESULTADOS\n    \"resultados\": {\n      \"$resultadoId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    // 8. ASIGNACIONES DOCENTES\n    \"asignaciones_docentes\": {\n      \"$asignacionId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || auth.token.rol === 'profesional')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente')\"\n      }\n    },\n\n    // 9. CONTENIDO DEL PORTAL\n    \"contenido_portal\": {\n      \".read\": true,\n      \"$contenidoId\": {\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    }\n\n  }\n}"
