[debug] [2026-11-12T11:59:40.488Z] >>> [apiv2][body] PUT http://127.0.0.1:9000/.settings/rules.json "{\n  \"rules\": {\n    \n    \"usuarios\": {\n      \"$uid\": {\n        \".read\": \"auth != null && (auth.uid === $uid || auth.token.rol === 'admin' || auth.token.rol === 'profesional')\",\n        \".write\": \"auth != null && (auth.uid === $uid || auth.token.rol === 'admin')\"\n      }\n    },\n\n    \"pacientes\": {\n      \"$pacienteId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || (auth.token.rol === 'paciente' && auth.uid === $pacienteId))\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    \"profesionales\": {\n      \"$profesionalId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null && auth.token.rol === 'admin'\"\n      }\n    },\n\n    \"citas\": {\n      \"$citaId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\"\n      }\n    },\n\n    \"actos_clinicos\": {\n      \"$actoId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    \"solicitudes_prueba\": {\n      \"$solicitudId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    \"resultados\": {\n      \"$resultadoId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    \"asignaciones_docentes\": {\n      \"$asignacionId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || auth.token.rol === 'profesional')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente')\"\n      }\n    },\n\n    \"contenido_portal\": {\n      \".read\": true,\n      \"$contenidoId\": {\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    }\n\n  }\n}"
