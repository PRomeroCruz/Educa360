[debug] [2026-11-14T22:37:35.857Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/educa360-dev:securityRules [none]
[debug] [2026-11-14T22:37:35.858Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/educa360-dev:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function getRol() {\n      return (request.auth != null && request.auth.token != null && request.auth.token.keys().hasAll(['rol'])) \n        ? request.auth.token.rol \n        : '';\n    }\n\n    // 1. GESTIÓN DE USUARIOS Y ACCESOS\n    match /usuarios/{uid} {\n      // Permitir leer la lista de usuarios si está autenticado (necesario para listar médicos en citas)\n      allow read: if request.auth != null;\n      allow write: if request.auth != null && (\n        request.auth.uid == uid || \n        getRol() == 'admin' ||\n        getRol() == 'admin_sistema'\n      );\n    }\n\n    // 2. PACIENTES\n    match /pacientes/{pacienteId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // 3. PROFESIONALES (Separación de datos públicos e internos)\n    \n    // 3.1. Perfil público: Visible para todo el mundo (incluso sin iniciar sesión, para el cuadro médico)\n    match /profesionales_publicos/{profesionalId} {\n      allow read: if true;\n      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema']);\n    }\n\n    // 3.2. Perfil interno: Solo accesible para personal autenticado de la clínica\n    match /profesionales_internos/{profesionalId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null && (getRol() in ['admin', 'admin_sistema', 'profesional']);\n    }\n\n    // 4. CITAS\n    match /citas/{citaId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // 5. ACTOS CLÍNICOS\n    match /actos_clinicos/{actoId} {\n      allow read: if request.auth != null;\n      allow create: if getRol() == 'profesional';\n      allow update: if getRol() in ['admin', 'profesional'];\n      allow delete: if false;\n    }\n\n    // 6. SOLICITUDES DE PRUEBA\n    match /solicitudes_prueba/{solicitudId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // 7. RESULTADOS\n    match /resultados/{resultadoId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // 8. ASIGNACIONES DOCENTES\n    match /asignaciones_docentes/{asignacionId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // 9. CONTENIDO DEL PORTAL\n    match /contenido_portal/{contenidoId} {\n      allow read: if true;\n      allow write: if getRol() in ['admin', 'admin_sistema', 'editor'];\n    }\n\n    // 10. AUDITORÍA\n    match /auditoria/{logId} {\n      allow read: if request.auth != null && (\n        resource.data.paciente_id == request.auth.uid ||\n        getRol() in ['admin', 'admin_sistema', 'profesional']\n      );\n      allow create: if request.auth != null && request.resource.data.usuario_id == request.auth.uid;\n      allow update, delete: if false;\n    }\n  }\n}\n"}]}}
