[info] i  firestore: Change detected, updating rules... 
[debug] [2026-11-10T11:16:49.920Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/educa360-dev:securityRules [none]
[debug] [2026-11-10T11:16:49.920Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/educa360-dev:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // 1. GESTIÓN DE USUARIOS Y ACCESOS\n    match /usuarios/{uid} {\n      allow read, write: if true;\n    }\n\n    // 2. PACIENTES\n    match /pacientes/{pacienteId} {\n      allow read: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional' || \n        request.auth.get('token', {}).get('rol', '') == 'docente' || \n        request.auth.get('token', {}).get('rol', '') == 'estudiante' || \n        (request.auth.get('token', {}).get('rol', '') == 'paciente' && request.auth.uid == pacienteId)\n      );\n      allow write: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional'\n      );\n    }\n\n    // 3. PROFESIONALES\n    match /profesionales/{profesionalId} {\n      allow read: if request.auth != null;\n      allow write: if request.auth != null && request.auth.get('token', {}).get('rol', '') == 'admin';\n    }\n\n    // 4. CITAS (Modificado para permitir listar y leer correctamente a usuarios autenticados)\n    match /citas/{citaId} {\n      allow read, write, list: if request.auth != null;\n    }\n\n    // 5. ACTOS CLÍNICOS\n    match /actos_clinicos/{actoId} {\n      allow read: if request.auth != null && (\n        resource == null || \n        resource.data.professional_id == request.auth.uid ||\n        resource.data.paciente_id == request.auth.uid ||\n        request.auth.get('token', {}).get('rol', '') in ['admin', 'profesional', 'docente', 'estudiante']\n      );\n      \n      allow create: if request.auth != null && request.auth.get('token', {}).get('rol', '') == 'profesional';\n      \n      allow update: if request.auth != null \n        && resource != null \n        && resource.data.estado == 'Borrador' \n        && request.resource.data.estado in ['Borrador', 'Firmado']\n        && (request.auth.get('token', {}).get('rol', '') == 'admin' || request.auth.get('token', {}).get('rol', '') == 'profesional');\n        \n      allow delete: if false;\n    }\n\n    // 6. SOLICITUDES DE PRUEBA\n    match /solicitudes_prueba/{solicitudId} {\n      allow read: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional' || \n        request.auth.get('token', {}).get('rol', '') == 'paciente'\n      );\n      allow write: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional'\n      );\n    }\n\n    // 7. RESULTADOS\n    match /resultados/{resultadoId} {\n      allow read: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional' || \n        request.auth.get('token', {}).get('rol', '') == 'paciente'\n      );\n      allow write: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional'\n      );\n    }\n\n    // 8. ASIGNACIONES DOCENTES\n    match /asignaciones_docentes/{asignacionId} {\n      allow read: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'docente' || \n        request.auth.get('token', {}).get('rol', '') == 'estudiante' || \n        request.auth.get('token', {}).get('rol', '') == 'profesional'\n      );\n      allow write: if request.auth != null && (\n        request.auth.get('token', {}).get('rol', '') == 'admin' || \n        request.auth.get('token', {}).get('rol', '') == 'docente'\n      );\n    }\n\n    // 9. CONTENIDO DEL PORTAL\n    match /contenido_portal/{contenidoId} {\n      allow read: if true;\n      allow write: if request.auth != null && request.auth.get('token', {}).get('rol', '') == 'admin';\n    }\n\n    // 10. AUDITORÍA\n    match /auditoria/{logId} {\n      allow read: if request.auth != null && (\n        resource.data.paciente_id == request.auth.uid ||\n        request.auth.get('token', {}).get('rol', '') == 'admin' ||\n        request.auth.get('token', {}).get('rol', '') == 'profesional'\n      );\n      \n      allow create: if request.auth != null && request.resource.data.usuario_id == request.auth.uid;\n      \n      allow update, delete: if false;\n    }\n  }\n}"}]}}
