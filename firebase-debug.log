 PRUEBA\n    \"solicitudes_prueba\": {\n      \"$solicitudId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    // 7. RESULTADOS\n    \"resultados\": {\n      \"$resultadoId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional' || auth.token.rol === 'paciente')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    },\n\n    // 8. ASIGNACIONES DOCENTES\n    \"asignaciones_docentes\": {\n      \"$asignacionId\": {\n        \".read\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente' || auth.token.rol === 'estudiante' || auth.token.rol === 'profesional')\",\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'docente')\"\n      }\n    },\n\n    // 9. CONTENIDO DEL PORTAL\n    \"contenido_portal\": {\n      \".read\": true,\n      \"$contenidoId\": {\n        \".write\": \"auth != null && (auth.token.rol === 'admin' || auth.token.rol === 'profesional')\"\n      }\n    }\n\n  }\n}"
